# Home Dashboard Environment Variables Example

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/home_dashboard?schema=public"

# Auth Secret (Minimum 32 random characters)
AUTH_SECRET="your-32-character-secret-key-here"

# Portainer Integration (Optional / Deployment)
PORTAINER_URL="https://portainer.example.com"
PORTAINER_API_KEY="ptr_..."

# IAM Integration API Key (Exposes /api/iam/users and /api/iam/roles to IAM portal)
IAM_API_KEY="your-iam-api-key-here"
